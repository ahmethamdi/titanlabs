# WordPress core — reinstalled via wp core download
/wp-admin/
/wp-includes/
/wp-*.php
/index.php
/xmlrpc.php
/license.txt
/readme.html

# Config & secrets
wp-config.php

# Environment-specific: RewriteBase differs between the XAMPP subfolder and the
# server's document root, so a committed copy takes the whole live site down
# with a 500 on every pretty permalink. setup.sh writes the right one per host.
.htaccess

# Uploads and generated content
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-content/debug.log
/wp-content/languages/

# Third-party plugins (installed via composer/wp-cli)
/wp-content/plugins/
!/wp-content/plugins/index.php

# Default themes
/wp-content/themes/twenty*

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
node_modules/
.claude/
